# Ігнорувати node_modules у будь-яких підпапках проєктів
**/node_modules/
**/.pnp/
**/path/to/.pnp.js

# Локальні конфіги та секрети
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Логи помилок
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Папки збірки проєктів
**/build/
**/dist/

# Системні файли
.DS_Store
Thumbs.db